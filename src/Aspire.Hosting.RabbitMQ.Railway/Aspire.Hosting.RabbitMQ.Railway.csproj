<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>PinguApps.Aspire.Hosting.RabbitMQ.Railway</PackageId>
    <AssemblyName>PinguApps.Aspire.Hosting.RabbitMQ.Railway</AssemblyName>
    <Description>Deploy standard Aspire RabbitMQ resources to Railway with private AMQP and authenticated HTTPS management.</Description>
    <EnableAspireIntegrationAnalyzers>true</EnableAspireIntegrationAnalyzers>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" />
