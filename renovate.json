{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>PinguApps/renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "dotnet tool install -g Aspire\\.Cli --version (?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "nuget",
      "depNameTemplate": "Aspire.Cli",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)(samples/TypeScriptAppHost|tests/Aspire\\.Hosting\\.RabbitMQ\\.Railway/Fixtures/TypeScriptAppHost)/aspire\\.config\\.json$/"
      ],
      "matchStrings": [
        "\"sdk\"\\s*:\\s*\\{\\s*\"version\"\\s*:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "nuget",
      "depNameTemplate": "Aspire.Cli",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)(README\\.md|docs/install\\.md|samples/TypeScriptAppHost/aspire\\.config\\.json|tests/Aspire\\.Hosting\\.RabbitMQ\\.Railway/Fixtures/TypeScriptAppHost/aspire\\.config\\.json)$/",
        "/^docs/getting-started-typescript\\.md$/"
      ],
      "matchStrings": [
        "\"Aspire\\.Hosting\\.RabbitMQ\"\\s*:\\s*\"(?<currentValue>[^\"]+)\"",
        "(?:dotnet add package Aspire\\.Hosting\\.RabbitMQ --version |`Aspire\\.Hosting\\.RabbitMQ` )(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "nuget",
      "depNameTemplate": "Aspire.Hosting.RabbitMQ",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)AGENTS\\.md$/"
      ],
      "matchStrings": [
        "Target Aspire version:\\s*`(?<currentValue>[^`]+)`"
      ],
      "datasourceTemplate": "nuget",
      "depNameTemplate": "Aspire.Hosting",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^README\\.md$/",
        "/^docs/(?:install|getting-started-dotnet|getting-started-typescript)\\.md$/"
      ],
      "matchStrings": [
        "Aspire (?:CLI )?(?<currentValue>\\d+\\.\\d+\\.\\d+)(?:[ .,/]|$)"
      ],
      "datasourceTemplate": "nuget",
      "depNameTemplate": "Aspire.Hosting",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^README\\.md$/",
        "/^docs/(?:install|getting-started-dotnet|getting-started-typescript)\\.md$/",
        "/(^|/)(samples/TypeScriptAppHost|tests/Aspire\\.Hosting\\.RabbitMQ\\.Railway/Fixtures/TypeScriptAppHost)/aspire\\.config\\.json$/"
      ],
      "matchStrings": [
        "\"PinguApps\\.Aspire\\.Hosting\\.Railway\"\\s*:\\s*\"(?<currentValue>[^\"]+)\"",
        "`PinguApps\\.Aspire\\.Hosting\\.Railway` (?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "nuget",
      "depNameTemplate": "PinguApps.Aspire.Hosting.Railway",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["/^Aspire(?:\\.|$)/i"],
      "enabled": false
    }
  ]
}
